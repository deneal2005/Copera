# Runtime
SMX_HOST=127.0.0.1
SMX_PORT=8080
SMX_ENV=development
SMX_DATABASE=data/xerox.sqlite3
SMX_STORAGE=data/private-documents
SMX_SECURE_COOKIES=false
SMX_PUBLIC_BASE_URL=http://127.0.0.1:8080
SMX_MAX_REQUEST_BYTES=12582912

# Razorpay: leave blank to disable online checkout until credentials are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Print agent settings belong on the computer with the printer, not this server.
# Windows agent only: set SMX_SUMATRA_PATH to the full path to SumatraPDF.exe.
